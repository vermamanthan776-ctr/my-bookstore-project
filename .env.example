PORT=3000
NODE_ENV=development

# Replace with your MongoDB Atlas connection string before deployment.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/bookstore?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Gmail: enable 2-Step Verification and create a Google App Password.
# Put that 16-character App Password in SMTP_PASS (not your normal Gmail password).
# Restart the app after changing .env so it reads the updated credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-gmail@gmail.com
CONTACT_EMAIL=your-gmail@gmail.com
