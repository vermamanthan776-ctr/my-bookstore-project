<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#24352d">
    <title>Book Categories | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/categories.css">
</head>

<body>
    <%- include('includes/nav.ejs') %>

    <main id="categories-root"
        data-initial-state="<%= JSON.stringify({ books, categories, selectedCategory: selectedCategory || '' }) %>">
        <div class="categories-loading" role="status">Loading your reading list…</div>
    </main>

    <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
    <script src="/categories.js"></script>
</body>
</html>
