<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Manage orders | The Bookshop</title><script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script></head>
<body class="min-h-screen bg-[#fbf8f2] text-[#25372d]">
    <%- include('includes/nav.ejs') %>
    <main class="mx-auto max-w-7xl px-5 py-12">
        <h1 class="font-serif text-4xl font-bold">All order history</h1>
        <p class="mt-2 text-[#68746b]"><%= orders.length %> <%= orders.length === 1 ? 'order' : 'orders' %> · newest orders appear first</p>
        <% if (statusUpdated) { %><p class="mt-5 rounded-xl bg-[#edf3ed] px-4 py-3 text-sm text-[#315b43]" role="status">Order status updated and saved. The latest status is shown below.</p><% } %>
        <% if (notification === 'sent') { %><p class="mt-5 rounded-xl bg-[#edf3ed] px-4 py-3 text-sm text-[#315b43]">Order notification email sent.</p><% } else if (notification === 'failed') { %><p class="mt-5 rounded-xl bg-[#fff3e8] px-4 py-3 text-sm text-[#8a4b17]">Could not send the order notification. Check the SMTP settings and try again.</p><% } %>
        <% if (orders.length) { %>
            <div class="mt-8 space-y-4"><% orders.forEach(order => { %>
                <article class="rounded-2xl bg-white p-5 shadow-sm">
                    <div class="flex flex-wrap justify-between gap-4">
                        <div><a href="/orders/<%= order._id %>" class="font-semibold text-[#234735] underline">Order #<%= String(order._id).slice(-8).toUpperCase() %> · View full details</a><p class="mt-1 text-sm text-[#68746b]"><%= order.shipping.name %> · Guest checkout</p><p class="text-sm text-[#68746b]"><%= new Date(order.createdAt).toLocaleString() %> · <%= order.shipping.phone %></p></div>
                        <div class="text-right"><p class="font-bold">₹<%= Number(order.total).toLocaleString('en-IN') %></p><span class="inline-block rounded-full bg-[#edf3ed] px-3 py-1 text-sm font-semibold text-[#315b43]"><%= order.status %></span></div>
                    </div>
                    <p class="mt-3 text-sm"><%= order.items.map(item => `${item.title} × ${item.quantity}`).join(', ') %></p>
                    <p class="mt-1 text-sm text-[#68746b]"><%= order.shipping.address %>, <%= order.shipping.city %> <%= order.shipping.postalCode %></p>
                    <div class="mt-3 flex flex-wrap items-center gap-3">
                        <p class="text-sm text-[#68746b]">Email notification: <strong><%= order.notificationStatus || 'Pending' %></strong></p>
                        <% if (order.notificationStatus !== 'Sent') { %>
                            <form action="/admin/orders/<%= order._id %>/email" method="post">
                                <button class="rounded-full border border-[#234735] px-4 py-2 text-sm font-semibold text-[#234735]">Send email again</button>
                            </form>
                        <% } %>
                    </div>
                    <form action="/admin/orders/<%= order._id %>/status" method="post" class="mt-4 flex flex-wrap items-center gap-2">
                        <label for="status-<%= order._id %>" class="sr-only">Update order status</label>
                        <select id="status-<%= order._id %>" name="status" required class="min-h-12 rounded-xl border border-[#d8ddd8] bg-white px-4 py-2 focus:border-[#315b43] focus:outline-none focus:ring-2 focus:ring-[#315b43]/20"><% ['Processing', 'Shipped', 'Delivered', 'Cancelled'].forEach(status => { %><option value="<%= status %>" <%= order.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select>
                        <button type="submit" class="min-h-12 rounded-full bg-[#234735] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#315b43] focus:outline-none focus:ring-2 focus:ring-[#315b43] focus:ring-offset-2">Update status</button>
                    </form>
                </article>
            <% }) %></div>
        <% } else { %><p class="mt-8 rounded-2xl bg-white p-8 text-[#68746b]">There are no orders yet.</p><% } %>
    </main>
    <%- include('includes/footer.ejs') %>
</body>
</html>
