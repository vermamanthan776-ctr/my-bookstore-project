<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>My orders | The Bookshop</title><script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script></head>
<body class="min-h-screen bg-[#fbf8f2] text-[#25372d]">
    <%- include('includes/nav.ejs') %>
    <main class="mx-auto max-w-5xl px-5 py-12">
        <h1 class="font-serif text-4xl font-bold">My orders</h1>
        <% if (orders.length) { %>
            <div class="mt-8 space-y-4"><% orders.forEach(order => { %>
                <a href="/orders/<%= order._id %>" class="block rounded-2xl bg-white p-5 shadow-sm transition hover:shadow-md">
                    <div class="flex flex-wrap items-center justify-between gap-3"><div><p class="font-semibold">Order <span class="font-mono text-sm">#<%= String(order._id).slice(-8).toUpperCase() %></span></p><p class="mt-1 text-sm text-[#68746b]"><%= new Date(order.createdAt).toLocaleDateString() %> · <%= order.items.length %> item(s)</p></div><div class="text-right"><p class="font-bold">₹<%= Number(order.total).toLocaleString('en-IN') %></p><span class="mt-1 inline-block rounded-full bg-[#edf3ed] px-3 py-1 text-xs font-semibold text-[#315b43]"><%= order.status %></span></div></div>
                </a>
            <% }) %></div>
        <% } else { %><section class="mt-8 rounded-3xl bg-white p-12 text-center"><h2 class="font-serif text-2xl font-bold">No orders yet</h2><p class="mt-2 text-[#68746b]">Your next favorite read is waiting.</p><a href="/books" class="mt-5 inline-block font-semibold text-[#234735] underline">Browse books</a></section><% } %>
    </main>
    <%- include('includes/footer.ejs') %>
</body>
</html>
