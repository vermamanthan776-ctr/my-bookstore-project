<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= book.title %> | The Bookshop</title><script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script></head>
<body class="min-h-screen bg-[#fbf8f2] text-[#25372d]">
    <%- include('includes/nav.ejs') %>
    <main class="mx-auto max-w-6xl px-5 py-12">
        <a href="/books" class="text-sm font-semibold text-[#315b43] hover:underline">← Back to books</a>
        <article class="mt-6 grid gap-10 rounded-3xl bg-white p-6 shadow-sm sm:p-10 md:grid-cols-2">
            <img src="<%= book.image %>" alt="Cover of <%= book.title %>" class="max-h-[34rem] w-full rounded-2xl bg-[#eee8dd] object-cover">
            <div class="flex flex-col justify-center">
                <p class="text-sm font-semibold uppercase tracking-widest text-[#ad7130]"><%= book.category %></p>
                <h1 class="mt-3 font-serif text-4xl font-bold"><%= book.title %></h1>
                <p class="mt-3 text-lg text-[#68746b]">by <%= book.author %></p>
                <p class="mt-6 text-3xl font-bold text-[#234735]">₹<%= Number(book.price).toLocaleString('en-IN') %></p>
                <p class="mt-6 leading-7 text-[#59665d]"><%= book.description || 'A wonderful addition to your reading shelf. Add this title to your cart and discover where the story takes you.' %></p>
                <form action="/cart/add/<%= book._id %>" method="post" class="mt-8 flex flex-wrap items-center gap-3">
                    <label for="quantity" class="text-sm font-medium">Quantity</label>
                    <input id="quantity" type="number" name="quantity" value="1" min="1" max="20" class="w-20 rounded-lg border border-[#d8ddd8] px-3 py-2">
                    <button class="rounded-full bg-[#234735] px-7 py-3 font-semibold text-white hover:bg-[#345d46]" type="submit">Add to cart</button>
                </form>
                <p class="mt-5 text-sm text-[#68746b]">Secure checkout · Cash on delivery</p>
            </div>
        </article>
    </main>
    <%- include('includes/footer.ejs') %>
</body>
</html>
